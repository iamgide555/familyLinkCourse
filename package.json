{
  "name": "familylink",
  "private": true,
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "engines": {
    "node": ">=22.22.3 <23"
  },
  "scripts": {
    "test": "npm run test:api",
    "test:api": "node --experimental-vm-modules --disable-warning=ExperimentalWarning node_modules/jest/bin/jest.js --config apps/api/jest.config.cjs --runInBand",
    "test:integration": "npm run test:api",
    "test:e2e": "env -u NO_COLOR playwright test",
    "typecheck": "tsc -p apps/api/tsconfig.json --noEmit && npm run typecheck --workspace @familylink/web",
    "build": "npm run build --workspace @familylink/api && npm run build --workspace @familylink/web",
    "dev": "concurrently -k -n api,web 'npm run dev --workspace @familylink/api' 'npm run dev --workspace @familylink/web'",
    "db:generate": "prisma generate --config apps/api/prisma.config.ts",
    "db:migrate:test": "prisma migrate deploy --config apps/api/prisma.config.ts",
    "db:seed": "tsx --tsconfig apps/api/tsconfig.json apps/api/prisma/seed.ts",
    "lint": "eslint apps packages tests --max-warnings 0"
  },
  "dependencies": {
    "@angular/common": "21.2.25",
    "@angular/compiler": "21.2.25",
    "@angular/core": "21.2.25",
    "@angular/forms": "21.2.25",
    "@angular/platform-browser": "21.2.25",
    "@angular/router": "21.2.25",
    "@nestjs/common": "12.1.3",
    "@nestjs/core": "12.1.3",
    "@nestjs/platform-express": "12.1.3",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "argon2": "0.45.1",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "1.4.7",
    "helmet": "8.3.0",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@angular/build": "21.2.25",
    "@angular/cli": "21.2.27",
    "@angular/compiler-cli": "21.2.25",
    "@axe-core/playwright": "4.14.0",
    "@nestjs/testing": "12.1.3",
    "@playwright/test": "1.64.1",
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "concurrently": "10.0.6",
    "eslint": "10.13.0",
    "jest": "30.5.2",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "supertest": "7.3.1",
    "ts-jest": "29.4.15",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "packageManager": "npm@12.2.0"
}
