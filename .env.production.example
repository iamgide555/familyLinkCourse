# Copy to .env.production on the server and fill in. Never commit the filled file.
# Keys: generate three DIFFERENT 32-byte values with `openssl rand -base64 32`. Keep them in the password manager
# AND a sealed printed copy held by a FamilyLink admin; they are never stored in the database, Git, images or backups.

DOMAIN=familylink.wongnok.dev
WEB_ORIGIN=https://familylink.wongnok.dev
ORGANIZATION_ID=familylink

POSTGRES_DB=familylink
POSTGRES_USER=familylink_owner
POSTGRES_PASSWORD=
APP_DB_PASSWORD=

FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
SESSION_SECRET=

# Staff-only mode: run without LINE. Staff use the website; members cannot sign in, and every notice goes to the
# call list on ข้อความแจ้งเตือน for staff to phone. Set to true and leave ALL LINE_* values empty. Email below is
# then optional. Remove this line (and fill in LINE) to switch to the full system later.
STAFF_ONLY_MODE=false

# LINE (from FamilyLink's LINE Developers console). The Login channel and the Messaging API channel belong to the
# same provider. Webhook URL to set in the console: https://<DOMAIN>/api/line/webhook
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=
LINE_LOGIN_CHANNEL_ID=
LINE_LIFF_ID=
LINE_RICH_MENU_MEMBER=
# Monthly push quota shown in LINE OA Manager (ask FamilyLink). Leave empty until confirmed.
LINE_MONTHLY_QUOTA=

# Email fallback (Resend by default). The sender address must be confirmed with FamilyLink.
EMAIL_API_KEY=
EMAIL_FROM=

# Backups
BACKUP_DIR=/mnt/second-disk/familylink-backups
RCLONE_CONFIG_DIR=/etc/familylink/rclone
RCLONE_REMOTE=gdrive-crypt
HEALTHCHECKS_URL=
