# Explicit local-development settings. Never use real member data during development.
NODE_ENV=development
DATABASE_URL=postgresql://familylink_test:synthetic-test-only@127.0.0.1:55432/familylink_test
ORGANIZATION_ID=familylink-development
WEB_ORIGIN=http://127.0.0.1:4200
PORT=3000
# Generate three distinct 32-byte keys, each encoded as base64; no default secrets.
FIELD_ENCRYPTION_KEY=
BLIND_INDEX_KEY=
SESSION_SECRET=
# Used only by npm run db:seed; supply your own values, then remove the password.
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=
BOOTSTRAP_ADMIN_PASSWORD=
